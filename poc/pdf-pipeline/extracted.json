      "paragraphs": [
        {
          "fontSize": 9.96,
          "fontName": "g_d0_f3",
          "x0": 58.08,
          "x1": 459.11342400000103,
          "y0": 494.40000000000003,
          "y1": 504.36,
          "text": "Streamline transition with a comprehensive offboarding checklist for departing employees",
          "type": "body"
        },
        {
          "fontSize": 11.051,
          "fontName": "g_d0_f4",
          "x0": 97.933,
          "x1": 432.9272085,
          "y0": 466.06100000000004,
          "y1": 477.112,
          "text": "Action planStatus",
          "type": "body"
        },
        {
          "fontSize": 9.67,
          "fontName": "g_d0_f5",
          "x0": 97.931,
          "x1": 384.95594000000034,
          "y0": 438.722,
          "y1": 459.995,
          "text": "Provide robust documentation on the projects being worked on and their state/outstanding tasks.",
          "type": "body"
        },
        {
          "fontSize": 9.67,
          "fontName": "g_d0_f5",
          "x0": 97.931,
          "x1": 379.0282300000003,
          "y0": 394.173,
          "y1": 427.05,
          "text": "Document the important system designs and the processes. If the documentation already exists, make sure it's useful, relevant, and up to date.",
          "type": "body"
        },
        {
          "fontSize": 9.67,
          "fontName": "g_d0_f5",
          "x0": 97.931,
          "x1": 381.71649000000025,
          "y0": 347.954,
          "y1": 380.831,
          "text": "Hold technical talks or lunch-and-learn sessions that are recorded, and cover the essential details of the systems and projects they’ve worked on in their time at the company.",
          "type": "body"
        },
        {
          "fontSize": 9.67,
          "fontName": "g_d0_f5",
          "x0": 97.931,
          "x1": 366.1091100000002,
          "y0": 288.054,
          "y1": 332.534,
          "text": "Do pair programming sessions with team members for critical components as needed, especially to share troubleshooting mechanisms for common production issues, ensuring that they are well documented.",
          "type": "body"
        },
        {
          "fontSize": 9.67,
          "fontName": "g_d0_f5",
          "x0": 97.931,
          "x1": 374.1448800000003,
          "y0": 251.91300000000004,
          "y1": 273.186,
          "text": "Review any access permissions, and revoke all access to critical systems, infrastructure, and so on for the departing employee.",
          "type": "body"
        },
        {
          "fontSize": 9.67,
          "fontName": "g_d0_f5",
          "x0": 97.931,
          "x1": 354.8145500000002,
          "y0": 217.048,
          "y1": 238.321,
          "text": "Retrieve important contacts for cross-functional partners per project/points of contact.",
          "type": "body"
        },
        {
          "fontSize": 9.67,
          "fontName": "g_d0_f5",
          "x0": 97.932,
          "x1": 243.56220000000002,
          "y0": 192.625,
          "y1": 202.295,
          "text": "Do a manager-level exit interview.",
          "type": "body"
        },
        {
          "fontSize": 9.67,
          "fontName": "g_d0_f5",
          "x0": 97.932,
          "x1": 345.1745600000002,
          "y0": 168.86200000000002,
          "y1": 178.532,
          "text": "Provide a thank-you note for the employee from the team.",
          "type": "body"
        }
      ]
    },
